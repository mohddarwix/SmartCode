# Normalize all text files to LF in the repository and on checkout.
# This ensures CI on Linux gets LF line endings regardless of the OS
# files were committed from.
* text=auto eol=lf

# Treat these explicitly as binary to avoid corruption.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
