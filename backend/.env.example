# Copy to backend/.env (gitignored) and edit before running.

# SQLAlchemy URL. Default targets the local MariaDB on port 3307.
DATABASE_URL=mysql+pymysql://root:12345678@127.0.0.1:3307/ai_tutor_system

# JWT signing key. Generate a fresh one for any environment that isn't local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# CORS origins allowed to call the API. Comma-separated.
CORS_ORIGINS=http://localhost:5173

# --- LLM (Google Gemini) ---
# Get a free API key at https://aistudio.google.com/app/apikey.
# Leave blank to disable LLM features (we fall back to deterministic
# heuristics; the UI keeps working).
GOOGLE_API_KEY=

# Model to use. gemini-2.5-flash is fast and free-tier-friendly. Use
# gemini-2.5-pro for higher-quality reasoning if you hit quality limits.
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=4096
